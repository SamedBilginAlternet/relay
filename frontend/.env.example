# Which data source the UI talks to.
#   mock -> scripted run, no backend needed (default; demo-safe)
#   api  -> real REST + SSE endpoints
VITE_RUN_SOURCE=mock

# Base URL for the API. Empty is treated as "not set" -> falls back to /api.
VITE_API_BASE_URL=/api

# Only used by `npm run dev` (Vite proxy target for /api).
VITE_DEV_API_TARGET=http://localhost:8080
