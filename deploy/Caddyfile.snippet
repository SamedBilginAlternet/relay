# ===========================================================================
# Relay — Caddy site block
# ===========================================================================
#
# NEREYE EKLENECEK  *** DROPLET'İ DÜZENLEMEYİN ***
# ------------------------------------------------
# Caddyfile CI ile yönetiliyor: n11 deploy'u onu `/opt/n11/Caddyfile`'a
# kopyalıyor, yani sunucuda elle yapılan düzenleme ilk deploy'da SİLİNİR.
#
# Düzenlenecek gerçek dosya, n11 reposunda:
#     infra/digitalocean/Caddyfile
#
# Bloğu dosyanın sonundaki diğer proje bloklarının yanına ekleyin
# (faruktekstil / kpssatlas / olay / rung ile aynı bölüm), commit'leyin, n11'i
# deploy edin. Caddy TLS'i Let's Encrypt ile kendi alır.
#
# NEDEN host.docker.internal, NEDEN 127.0.0.1 DEĞİL
# --------------------------------------------------
# Caddy bu kutuda bir KONTEYNER içinde çalışıyor ve `extra_hosts: host-gateway`
# ile host'a ulaşıyor. `127.0.0.1` yazarsanız Caddy'nin KENDİ loopback'ini
# gösterir, host'unkini değil — sonuç 502. Aynı sebeple Relay'in compose
# dosyası portları `127.0.0.1:` ile DEĞİL, tüm arayüzlere yayımlıyor.
#
# COOLIFY TARAFI
# --------------
#   * Server -> Proxy: None/stopped. Açılırsa 80/443 için n11'in Caddy'siyle
#     kavga eder ve KUTUDAKİ HER SİTEYİ düşürür.
#   * Resource -> Domains/FQDN: BOŞ bırakın.
#   * SERVICE_FQDN_WEB / SERVICE_URL_WEB TANIMLAMAYIN — bunlar Coolify'ın
#     sihirli değişkenleri; verildiğinde Coolify servise domain atayıp kendi
#     proxy'sine yönlendirme etiketleri ekler.
#   Domain'i yalnızca aşağıdaki blok bilir.
#
# PORTLAR
# -------
# 8081 = Faruk, 8082 = KPSS Atlas, 8083 = Olaylar Arşivi, 8084/8085 = Rung.
# Relay sıradaki ikisini alıyor: 8086 (web) ve 8087 (api).
# Deploy etmeden ÖNCE boş olduklarını doğrulayın, varsaymayın:
#     for p in $(seq 8086 8099); do ss -tln | grep -q ":$p " || echo "BOS: $p"; done
# Değiştirirseniz .env'deki WEB_PORT/API_PORT ile bu blok AYNI olmalı.
#
# --------------------------- BURADAN KOPYALA -------------------------------

# Relay (Coolify ile yonetilir, web 8086 / api 8087)
relay.samedbilgin.com {
    # SSE akisi ONCE gelmeli — asagidaki genel /api/* bloguyla ayni yolu
    # esliyor ve Caddy ilk eslesen `handle`i kullanir.
    # `encode` BILEREK yok: SSE'yi sikistirmak frame'leri buffer'lar, olaylar
    # toplu halde gelir ve arayuz DONMUS gorunur (adimlar bir anda akar).
    # `flush_interval -1` her yazmayi aninda istemciye iter.
    handle /api/runs/*/stream {
        reverse_proxy host.docker.internal:8087 {
            flush_interval -1
        }
    }

    handle /api/* {
        encode zstd gzip
        reverse_proxy host.docker.internal:8087
    }

    handle {
        encode zstd gzip
        reverse_proxy host.docker.internal:8086
    }

    log {
        output stdout
        format console
    }
}

# ---------------------------- BURAYA KADAR ---------------------------------
#
# DIKKAT: `log {` suslu parantezi KENDI SATIRINDA olmali.
# `log { output stdout` tek satirda yazilirsa Caddy "Unexpected next token" verir.
#
# DOGRULAMA (n11 deploy'undan sonra)
# ----------------------------------
#   curl -sS https://relay.samedbilgin.com/api/health ; echo
#   curl -sSI https://relay.samedbilgin.com/ | head -n1
#
#   # SSE: header'lar aninda gelmeli, `content-type: text/event-stream` ve
#   # `content-encoding` YOK. Varsa `encode` yanlislikla bu yola sizmis demektir.
#   curl -sSI -H 'Accept: text/event-stream' \
#        https://relay.samedbilgin.com/api/runs/00000000-0000-0000-0000-000000000000/stream
#
#   # Canli akis testi (gercek bir runId ile): olaylar TEK TEK dusmeli,
#   # 30 saniye sessizlik sonrasi toplu halde degil.
#   curl -N -H 'Accept: text/event-stream' \
#        https://relay.samedbilgin.com/api/runs/<RUN_ID>/stream
