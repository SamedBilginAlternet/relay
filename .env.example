# ===========================================================================
# Relay — environment template
#
# DEPLOYING VIA COOLIFY (the normal path):
#   Do NOT put this file on the server. Copy its contents into the Coolify
#   resource -> Environment Variables -> Bulk Edit. Coolify writes the real
#   .env next to the compose file at deploy time. Mark POSTGRES_PASSWORD,
#   APP_ENCRYPTION_KEY and GROQ_API_KEYS as secret.
#
# DEPLOYING MANUALLY (or locally):
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env    # POSTGRES_PASSWORD + APP_ENCRYPTION_KEY + APP_DOMAIN
#
# .env is gitignored. NEVER commit a filled-in copy.
# Every value below has a sensible default in the compose files except
# POSTGRES_PASSWORD and APP_ENCRYPTION_KEY: those two are required, and the api
# container's entrypoint REFUSES TO START without them (the compose file cannot
# enforce it — see §7).
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. PUBLIC ADDRESS
# ---------------------------------------------------------------------------

# The domain the app is served on. Used for the Caddy site block and as the
# default CORS origin. No scheme, no trailing slash.
APP_DOMAIN=relay.samedbilgin.com


# ---------------------------------------------------------------------------
# 2. HOST PORTS  *** THE SHARED EDGE RULE ***
# ---------------------------------------------------------------------------
# The VPS already runs another project's Caddy as the ONLY process bound to
# :80/:443 (and the Coolify proxy stays OFF). Relay therefore publishes its own
# high ports and Caddy reverse-proxies the domain to them.
#
# *** BU KUTUYA OZEL ***
# Caddy bir KONTEYNER icinde ve servislere `host.docker.internal:<port>` ile
# ulasiyor — yani host gateway'e, loopback'e DEGIL. Bu yuzden compose portlari
# 127.0.0.1'e DEGIL tum arayuzlere yayimliyor. Bedeli: port dogrudan da acik
# kalir (http://187.124.7.138:<WEB_PORT>) ve orada TLS YOKTUR.
#
# Alinan portlar: 8081 Faruk, 8082 KPSS Atlas, 8083 Olaylar Arsivi,
# 8084 + 8085 Rung. Relay sonraki bos ciftle geliyor: 8086 / 8087.
# Bos oldugunu VARSAYMAYIN, bakin:
#   for p in $(seq 8086 8099); do ss -tln | grep -q ":$p " || echo "BOS: $p"; done
# Degistirirseniz .env ve deploy/Caddyfile.snippet AYNI olmali.

WEB_PORT=8086          # -> web container :80   (static SPA)
API_PORT=8087          # -> api container :8080 (REST + SSE)

# Development only: the port psql/DataGrip use to reach the dev database.
# docker-compose.prod.yml does NOT publish postgres at all.
DB_PORT=5432


# ---------------------------------------------------------------------------
# 3. DATABASE
# ---------------------------------------------------------------------------

POSTGRES_USER=relay
POSTGRES_DB=relay

# REQUIRED. The api entrypoint exits non-zero if this is empty or still says
# "change-me...". Generate one:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=change-me-before-deploying

# Optional Postgres tuning (defaults shown).
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_SHM_SIZE=256mb

# Where `--profile backup` writes pg_dump archives (host path).
BACKUP_DIR=./backups


# ---------------------------------------------------------------------------
# 4. BACKEND CONFIGURATION (Java 21 / Spring Boot 3.4)
#    Spring maps SPRING_DATASOURCE_URL -> spring.datasource.url, and so on;
#    the app's own keys arrive as plain environment variables.
# ---------------------------------------------------------------------------

# JDBC URL. `db` is the compose service name — do NOT use localhost here: from
# inside the api container localhost is the api itself (the entrypoint rejects
# it). Leave these three commented to let compose build them from POSTGRES_*.
#SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/relay
#SPRING_DATASOURCE_USERNAME=relay
#SPRING_DATASOURCE_PASSWORD=change-me-before-deploying

# Groq API keys, COMMA-SEPARATED — the rotation list (ARCHITECTURE.md §7).
# A key that returns 429/quota errors is put on cooldown and the next one takes
# over. Empty => the backend runs on StubLlmClient: deterministic, offline, and
# obviously fake. Safe for a demo, useless as a product.
GROQ_API_KEYS=

# Groq model id used for planning/execution.
GROQ_MODEL=llama-3.3-70b-versatile

# REQUIRED. AES-GCM key that encrypts Connection.config (Jira/Slack tokens) at
# rest. Min 32 characters; the api entrypoint refuses to start otherwise.
# Generate one:  openssl rand -base64 32
# CHANGING IT LATER MAKES EVERY STORED TOKEN UNDECRYPTABLE — the connections
# must be re-entered. Treat it like the database password.
APP_ENCRYPTION_KEY=change-me-before-deploying

# Tool execution mode:
#   stub = deterministic offline Jira/Slack fakes (demo-safe, no side effects)
#   live = real API calls with the tokens stored under /api/connections
TOOLS_MODE=stub

# Comma-separated list of allowed browser origins.
# Production: the SPA is same-origin with the API (both behind Caddy on
# https://${APP_DOMAIN}), so one entry is enough.
# Development: the SPA sits on :8086 (or the Vite dev server on :5173) while
# the API sits on :8087, so those origins must be listed.
CORS_ALLOWED_ORIGINS=https://relay.samedbilgin.com
#CORS_ALLOWED_ORIGINS=http://127.0.0.1:8086,http://localhost:8086,http://localhost:5173

# --- Sign-in ---------------------------------------------------------------
# Relay is ONE SHARED WORKSPACE: signing in says who is at the keyboard, it does
# not give anyone a private copy of the connections or the run history.
#
# Google sign-in reuses GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (the same OAuth
# client as the Gmail/Calendar connection) but has its OWN redirect URI and asks
# only for `openid email profile`. Register BOTH URIs in the Google console:
#   https://${APP_DOMAIN}/api/oauth/google/callback   (Gmail + Calendar data)
#   https://${APP_DOMAIN}/api/auth/google/callback    (sign-in only)
# Leave GOOGLE_LOGIN_REDIRECT_URI empty to derive it from the incoming request —
# correct whenever the SPA and the API share an origin (they do behind Caddy).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN_REDIRECT_URI=

# Where the browser lands after a successful Google sign-in. `/` is right for a
# same-origin deploy; a split dev setup needs the SPA's own address.
AUTH_SUCCESS_REDIRECT=/

# Session cookie flags. Keep `true` anywhere with HTTPS (browsers exempt
# localhost, so local development needs no change). AUTH_ENABLED=false removes
# the guard entirely and is ONLY for an offline demo you fully control.
AUTH_COOKIE_SECURE=true
AUTH_ENABLED=true

# Spring profile. `prod` in production, `dev` locally.
SPRING_PROFILES_ACTIVE=prod

# JVM flags for the api container. MaxRAMPercentage matters on a small droplet:
# without it the JVM sizes the heap against the HOST's RAM, not the container's.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.awt.headless=true -Dfile.encoding=UTF-8


# ---------------------------------------------------------------------------
# 5. FRONTEND BUILD ARGS (Vite bakes these in at BUILD time — changing them
#    requires `docker compose build web`, a restart is not enough)
# ---------------------------------------------------------------------------

# Run kaynagi. `api` = gercek backend, `mock` = repodaki fixture.
# PROD'DA `api` OLMALI — `mock` birakilirsa SPA sahte kosularla yayina cikar.
VITE_RUN_SOURCE=api

# SPA'nin /api icin kullandigi taban adres (SSE akisi dahil).
# Prod: BOS birakin = same-origin, Caddy yonlendirir.
# Gelistirme: http://127.0.0.1:8087/api
VITE_API_BASE_URL=


# ---------------------------------------------------------------------------
# 6. BUILD / RELEASE
# ---------------------------------------------------------------------------

# Compose project name -> network name and volume name (the production compose
# file sets no container names; Coolify assigns those). Must be unique per
# project on a shared box, and must NOT change after the first deploy or the
# database volume `<name>-db-data` is orphaned.
COMPOSE_PROJECT_NAME=relay

# Image name prefix and tag. APP_VERSION is also passed to the Gradle build
# (-Pversion=) and is reported by GET /api/health.
IMAGE_PREFIX=relay
APP_VERSION=0.1.0

# Toolchain pins. JAVA_VERSION selects both the JDK build image and the JRE
# runtime image; keep it in line with the toolchain in backend/build.gradle.kts.
JAVA_VERSION=21
NODE_VERSION=22

# Container timezone.
TZ=Etc/UTC


# ---------------------------------------------------------------------------
# 7. COOLIFY TUZAKLARI — bunlar bu kutuda gercekten yasandi
# ---------------------------------------------------------------------------
#
# * `${VAR:?mesaj}` KULLANMAYIN. Coolify bu sozdizimini `:-` gibi okuyup HATA
#   MESAJINI DEGER olarak yapistiriyor. Eksik POSTGRES_PASSWORD deploy'u
#   dusurmez — veritabani, repoda acikca yazan bir parolayla ayaga kalkar.
#   Dogrulama compose'da degil, konteyner giris betiginde:
#   deploy/backend-entrypoint.sh.
#
# * SERVICE_FQDN_WEB / SERVICE_URL_WEB TANIMLAMAYIN ve Coolify'daki
#   Domains/FQDN alanini BOS birakin. Coolify bunlari gorunce servise domain
#   atayip kendi proxy'sine etiket ekler; bu kutuda o proxy kapali olmali,
#   yoksa 80/443'u n11'in Caddy'sinden kapar ve KUTUDAKI HER SITE duser.
#
# * POSTGRES_PASSWORD'u SONRADAN degistirmek ise yaramaz. Postgres onu yalnizca
#   BOS veri dizininde, ilk acilista kullanir. Volume varken degistirirseniz DB
#   eskisini beklemeye devam eder ve api kimlik dogrulamada olur.
#   Gercekten degistirmek icin:
#     docker compose -f docker-compose.prod.yml exec db \
#       psql -U relay -d relay -c "ALTER USER relay WITH PASSWORD 'yeni';"
#
# * COMPOSE_PROJECT_NAME ilk deploy'dan sonra DEGISMEMELI — volume oksuz kalir.
#
# * VITE_* degiskenlerini Coolify'da degistirmek RESTART ile gecmez; Redeploy
#   gerekir ve gerekirse "Use build cache" tiki kaldirilir.
