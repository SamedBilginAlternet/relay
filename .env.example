# ===========================================================================
# Rung — environment template
#
# DEPLOYING VIA COOLIFY (the normal path):
#   Do NOT put this file on the server. Copy its contents into the Coolify
#   resource -> Environment Variables -> Bulk Edit. Coolify writes the real
#   .env next to the compose file at deploy time. Mark POSTGRES_PASSWORD and
#   ANTHROPIC_API_KEY as secret.
#
# DEPLOYING MANUALLY (or locally):
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env        # fill in POSTGRES_PASSWORD and APP_DOMAIN at minimum
#
# .env is gitignored. NEVER commit a filled-in copy.
# Every value below has a sensible default in the compose files except
# POSTGRES_PASSWORD, which is deliberately required in production.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. PUBLIC ADDRESS
# ---------------------------------------------------------------------------

# The domain the app is served on. Used for the Caddy site block and as the
# default CORS origin. No scheme, no trailing slash.
APP_DOMAIN=rung.samedbilgin.com


# ---------------------------------------------------------------------------
# 2. HOST PORTS  *** THE SHARED EDGE RULE ***
# ---------------------------------------------------------------------------
# The VPS already runs another project's Caddy as the ONLY process bound to
# :80/:443 (and the Coolify proxy stays OFF). Rung therefore publishes to
# 127.0.0.1 on its own high ports, and Caddy reverse-proxies to them.
#
# *** BU KUTUYA OZEL ***
# Caddy bir KONTEYNER icinde ve servislere `host.docker.internal:<port>` ile
# ulasiyor — yani host gateway'e, loopback'e DEGIL. Bu yuzden compose portlari
# 127.0.0.1'e DEGIL tum arayuzlere yayimliyor. Bedeli: port dogrudan da acik
# kalir (http://187.124.7.138:<WEB_PORT>) ve orada TLS YOKTUR.
#
# Alinan portlar: 8081 Faruk, 8082 KPSS Atlas, 8083 Olaylar Arsivi.
# Bos oldugunu VARSAYMAYIN, bakin:
#   for p in $(seq 8084 8099); do ss -tln | grep -q ":$p " || echo "BOS: $p"; done
# Degistirirseniz .env ve deploy/Caddyfile.snippet AYNI olmali.

WEB_PORT=8084          # -> web container :80   (static SPA)
API_PORT=8085          # -> api container :8080 (REST + SignalR hub)

# Development only: the port psql/DataGrip use to reach the dev database.
# docker-compose.prod.yml does NOT publish postgres at all.
DB_PORT=5432


# ---------------------------------------------------------------------------
# 3. DATABASE
# ---------------------------------------------------------------------------

POSTGRES_USER=rung
POSTGRES_DB=rung

# REQUIRED in production — `up` fails fast if this is empty.
# Generate one:   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=change-me-before-deploying

# Optional Postgres tuning (defaults shown).
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_SHM_SIZE=256mb

# Where `--profile backup` writes pg_dump archives (host path).
BACKUP_DIR=./backups


# ---------------------------------------------------------------------------
# 4. BACKEND CONFIGURATION (ASP.NET Core reads these as configuration keys —
#    the double underscore is the section separator, e.g.
#    ConnectionStrings__Default  ==  appsettings.json ConnectionStrings:Default)
# ---------------------------------------------------------------------------

# Npgsql connection string. `Host=db` is the compose service name — do NOT use
# localhost here; from inside the api container localhost is the api itself.
# Leave commented to let compose build it from POSTGRES_* above.
#ConnectionStrings__Default=Host=db;Port=5432;Database=rung;Username=rung;Password=change-me-before-deploying;Pooling=true;Maximum Pool Size=50

# Comma-separated list of allowed browser origins.
# Production: the SPA is same-origin with the API (both behind Caddy on
# https://${APP_DOMAIN}), so one entry is enough.
# Development: the SPA sits on :8084 (or Vite dev server :5173) while the API
# sits on :8085, so those origins must be listed.
Cors__AllowedOrigins=https://rung.samedbilgin.com
#Cors__AllowedOrigins=http://127.0.0.1:8084,http://localhost:8084,http://localhost:5173

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# Card generation backend. `stub` = deterministic StubCardGenerator, no network,
# no API key, safe for demo day. `llm` = live generation.
GENERATION_PROVIDER=stub

# Only needed when GENERATION_PROVIDER=llm.
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# 5. FRONTEND BUILD ARGS (Vite bakes these in at BUILD time — changing them
#    requires `docker compose build web`, a restart is not enough)
# ---------------------------------------------------------------------------

# Kart kaynagi. `api` = gercek backend, `mock` = repodaki fixture.
# PROD'DA `api` OLMALI — bos birakilirsa SPA mock veriyle yayina cikar.
VITE_CARD_SOURCE=api

# Spring geri kaydirma iPhone'da bozulursa: smooth-fallback
VITE_SCROLL_STRATEGY=spring

# SPA'nin /api ve /hub icin kullandigi taban adres.
# Prod: BOS birakin = same-origin, Caddy yonlendirir. Kod bos stringi `/api`
# olarak yorumluyor, yani onek kaybolmaz.
# Gelistirme: http://127.0.0.1:8085/api
VITE_API_BASE_URL=


# ---------------------------------------------------------------------------
# 6. BUILD / RELEASE
# ---------------------------------------------------------------------------

# Compose project name -> network name and volume name (the production compose
# file sets no container names; Coolify assigns those). Must be unique per
# project on a shared box, and must NOT change after the first deploy or the
# database volume `<name>-db-data` is orphaned.
COMPOSE_PROJECT_NAME=rung

# Image name prefix and tag. APP_VERSION also becomes the .NET assembly version
# and is reported by GET /api/health.
IMAGE_PREFIX=rung
APP_VERSION=0.1.0

# Toolchain pins. Keep DOTNET_VERSION in sync with backend/global.json.
DOTNET_VERSION=10.0
NODE_VERSION=22

# Container timezone.
TZ=Etc/UTC


# ---------------------------------------------------------------------------
# 7. COOLIFY TUZAKLARI — bunlar bu kutuda gercekten yasandi
# ---------------------------------------------------------------------------
#
# * `${VAR:?mesaj}` KULLANMAYIN. Coolify bu sozdizimini `:-` gibi okuyup HATA
#   MESAJINI DEGER olarak yapistiriyor. Eksik POSTGRES_PASSWORD deploy'u
#   dusurmez — veritabani, repoda acikca yazan bir parolayla ayaga kalkar.
#   Dogrulama compose'da degil, konteyner giris betiginde yapilir.
#
# * SERVICE_FQDN_WEB / SERVICE_URL_WEB TANIMLAMAYIN. Coolify bunlari gorunce
#   servise domain atayip kendi proxy'sine etiket ekler; bu kutuda o proxy
#   kapali olmali.
#
# * POSTGRES_PASSWORD'u SONRADAN degistirmek ise yaramaz. Postgres onu yalnizca
#   BOS veri dizininde, ilk acilista kullanir. Volume varken degistirirseniz DB
#   eskisini beklemeye devam eder ve api kimlik dogrulamada olur.
#   Gercekten degistirmek icin:
#     docker compose -f docker-compose.prod.yml exec db \
#       psql -U rung -d rung -c "ALTER USER rung WITH PASSWORD 'yeni';"
#
# * COMPOSE_PROJECT_NAME ilk deploy'dan sonra DEGISMEMELI — volume oksuz kalir.
