# Relay backend — copy to .env and fill in. Never commit the filled version.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/relay
SPRING_DATASOURCE_USERNAME=relay
SPRING_DATASOURCE_PASSWORD=

# AES-GCM key for stored Jira/Slack tokens: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Comma separated Groq keys. Leave empty to run on the deterministic stub LLM.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# How long one HTTP call may take, and how long the whole provider chain (every
# tier, every key) may take before giving up and answering from the stub.
LLM_HTTP_TIMEOUT_SECONDS=10
LLM_ROUTING_BUDGET_SECONDS=20

# Provider access is code-locked to replay until connections belong to users.

CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_BUDGET_USD=0.50
