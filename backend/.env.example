# Relay backend — copy to .env and fill in. Never commit the filled version.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/relay
SPRING_DATASOURCE_USERNAME=relay
SPRING_DATASOURCE_PASSWORD=

# AES-GCM key for stored Jira/Slack tokens: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Comma separated Groq keys. Leave empty to run on the deterministic stub LLM.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# live | replay  — replay needs no accounts and no network
TOOLS_MODE=replay

CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_BUDGET_USD=0.50
